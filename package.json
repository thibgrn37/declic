{
  "name": "declic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Déclic : préparation mentale fondée sur la science pour sportifs, avec programme adaptatif.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build:artifact": "npm run build:single && node scripts/to-artifact.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.4.1",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vite-plugin-singlefile": "2.2.0",
    "vitest": "3.1.4"
  }
}
